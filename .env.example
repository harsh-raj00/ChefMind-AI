# ==============================================================================
# ChefMind AI — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env for local development and replace placeholders.
# For production deployments, configure these variables in your hosting provider's
# dashboard (e.g. Render, Railway, Vercel, Netlify).
#
# IMPORTANT: NEVER commit your actual .env file or production secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Node.js / Express)
# ------------------------------------------------------------------------------

# Port the Express server listens on (Node hosts like Render/Railway automatically inject PORT)
PORT=3000

# Node environment: 'development', 'test', or 'production'
NODE_ENV=development

# Allowed Frontend URL(s) for CORS. In production, set to your static frontend domain.
# Multiple origins can be comma-separated: https://chefmind.vercel.app,https://chefmind.com
CLIENT_URL=http://localhost:5173

# Set to 'true' if running behind a reverse proxy (e.g. Render, Heroku, AWS ALB, Cloudflare)
# to ensure rate limiting tracks genuine client IPs. Automatically enabled when NODE_ENV=production.
TRUST_PROXY=false

# MongoDB Atlas connection URI with database name
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/chefmind?retryWrites=true&w=majority

# Secret key used to sign and verify JSON Web Tokens (JWT)
# In production, must be at least 32 cryptographically random characters (e.g., generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters

# Groq API Key (Optional, Recommended as Primary LLM Engine)
# ChefMind AI routes structured recipe generation, culinary chat, and multi-modal
# image vision to Groq's ultra-low-latency Llama 3 models (llama-3.3-70b-versatile,
# llama-3.1-8b-instant, llama-3.2-11b-vision-preview) first.
# If Groq is unavailable, rate-limited, or not configured, ChefMind seamlessly cascades
# to Google Gemini without downtime or errors. Obtain free API key: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key from Google AI Studio / Google Cloud Console
# Serves as the robust primary fallback (or standalone engine if Groq is omitted).
# Keep strictly confidential on the backend. Never expose to the frontend.
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Frontend Configuration (React / Vite)
# ------------------------------------------------------------------------------
# NOTE: Set this variable in your static frontend hosting provider (e.g. Vercel, Netlify).
# In local development, leave empty so Vite dev server proxies "/api" to http://localhost:3000.
#
# SECURITY WARNING: Any variable prefixed with VITE_ is public and embedded into
# client bundles. NEVER put database credentials, JWT secrets, or Gemini API keys here!
VITE_API_BASE_URL=https://your-backend-api-url.example.com
